{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ask-my-cv",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "ask.luquematte.com", "custom_domain": true }],
  "vars": {
    "OPENAI_MODEL": "gpt-6-luna",
    "ALLOWED_ORIGINS": "https://luquematte.com,http://localhost:5188"
  },
  // Per-IP: 8 questions per minute.
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } }],
  "observability": { "enabled": true }
}
